# Optional HTTP(S) or SOCKS proxy, e.g. http://user:pass@host:port
PROXY_URL=

# Cap pages per source (0 = all pages). Useful while testing.
MAX_PAGES=0

# Request delay between pages in ms
PAGE_DELAY_MS=400

# Desktop notification when done (1/0). Uses notify-send on Linux when available.
NOTIFY=1

# Google Sheets — append new jobs (Company, Role, Job Link, Source, Date)
# Dedupe: skip only if same company + same role title already exist on the sheet.
# 1. Create a Google Cloud service account with Sheets API enabled
# 2. Download its JSON key and save as credentials/google-service-account.json
# 3. Share your spreadsheet with the service account email (Editor)
# 4. Paste the spreadsheet ID from the sheet URL
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Jobs
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
