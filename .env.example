# Optional HTTP(S) or SOCKS proxy, e.g. http://user:pass@host:port
PROXY_URL=

# Cap pages per source (0 = all pages). Useful while testing.
MAX_PAGES=0

# Request delay between pages in ms
PAGE_DELAY_MS=400

# Desktop notification when done (1/0). Uses notify-send on Linux when available.
NOTIFY=1

# Active profile (optional default if --profile is not passed):
# Clinton | Nathan | Andrei | Blake | Eric | Jay | Daniel
# Profile name = Google Sheet tab name (Eric/Jay/Daniel use fixed resume roots)
PROFILE=

# Google Sheets — one spreadsheet, one tab per profile
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

# Fallback CV root for filename-mode profiles.
# `{sheet}` → profile name (e.g. Clinton → D:\Remote\CV\Clinton)
# Eric/Jay/Daniel use E:\Data\RM\US Resume\Resumes\{name} (subdir mode) in profiles.ts
CV_DIR=D:\Remote\CV\{sheet}

# Andrei profile only (host:port:user:pass or http://user:pass@host:port)
ANDREI_PROXY_URL=

# Quote password if it contains # or spaces (dotenv treats unquoted # as a comment)
JOBRIGHT_EMAIL=
JOBRIGHT_PASSWORD=
JOBRIGHT_SESSION_ID=
JOBRIGHT_MAX_JOBS=100
JOBRIGHT_PAGE_DELAY_MS=7000

HIRINGCAFE_CHALLENGE_TIMEOUT_MS=300000
HIRINGCAFE_USE_PROXY=0

# Built In: HTTP listings + headed browser for ApplyRedirect (login once, then parallel tabs)
# Wait N ms, check login once, repeat up to M times (default: 1 min × 5)
BUILTIN_LOGIN_WAIT_MS=60000
BUILTIN_LOGIN_ATTEMPTS=5
BUILTIN_APPLY_CONCURRENCY=4

